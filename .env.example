# Application
APP_NAME=lbc-ft-fp-app
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database - PostgreSQL via Docker
POSTGRES_DB=lbc_db
POSTGRES_USER=lbc_user
POSTGRES_PASSWORD=lbc_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lbc_user:lbc_password@localhost:5432/lbc_db

# pgAdmin local connection helper
PGADMIN_HOST=localhost
PGADMIN_PORT=5432

# OpenSanctions - optional for real screening
OPEN_SANCTIONS_API_URL=https://api.opensanctions.org
OPEN_SANCTIONS_API_KEY=
SCREENING_MODE=mock

# Security - replace in local .env
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rules
HIGH_TRANSACTION_AMOUNT=1000000
DAILY_HIGH_TRANSACTION_LIMIT=5
DEFAULT_MATCH_THRESHOLD=85

